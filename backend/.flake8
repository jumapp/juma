# .flake8 configuration for the backend
max-line-length = 120
select = E,F,W,C,D
ignore = W503,W504,E501
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .venv,
    .env,
    env,
    *.pyc,
    venv,
    node_modules,
    frontend/node_modules,

per-file-ignores =
    __init__.py: F401
    app/routers/__init__.py: F401
    app/services/__init__.py: F401
    app/repositories/__init__.py: F401
