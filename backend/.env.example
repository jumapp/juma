# Jumapp Backend Environment Variables
# Copy this file to .env and adjust values as needed.

APP_NAME=Jumapp API
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jumapp
DB_ECHO=false
DB_AUTO_CREATE=true

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Auth (dev mode until an identity provider is selected)
AUTH_MODE=dev
SUPER_ADMIN_TOKEN=dev-super-admin-token

# Photo storage configuration
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_PHOTOS_PER_MASJID=5

# GCS (leave empty until credentials are provisioned; local storage is used then)
GCS_BUCKET=
GCS_PROJECT_ID=

# Note: Alembic scripts are NOT used in this implementation. Database setup is done via init_db.py and seed_data.py
# to maintain better control and avoid Alembic's complexity for this project.
