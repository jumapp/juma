# Frontend environment configuration
# Copy to .env and adjust values as needed

# =============================================================================
# Production / Web deployment
# =============================================================================

# Backend API URL (Render deployment)
# Used by lib/config.ts for web builds
API_URL=https://jumapp-api.onrender.com

# API prefix (matches backend routers)
API_PREFIX=/api/v1

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=15000

# =============================================================================
# Expo mobile dev (EXPO_PUBLIC_* vars are inlined into the bundle by Expo)
# =============================================================================

# Web URL (used by Expo web builds when API_URL is not set)
EXPO_PUBLIC_API_URL_WEB=http://localhost:8000

# Mobile URL — set automatically by `npm run start:proxy` (ngrok tunnel to backend)
# For physical device testing, point this at a tunnel or your LAN backend.
EXPO_PUBLIC_API_URL_MOBILE=http://localhost:8000

# Local dev (uncomment for local runs)
# API_URL=http://localhost:8000